# =====[ Appearance ]=====
font_family      FiraCode
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        11.0
adjust_line_height 0
adjust_column_width 0

# =====[ Opacity / Background ]=====
background_opacity 0.85
background #000000
foreground #F8F8F2

# Cursor
cursor #FF5555
cursor_shape block

# Selection
selection_foreground #000000
selection_background #FF5555

# =====[ Color Scheme — FreeBSD-inspired Red/Dark ]=====
color0  #1C1C1C
color1  #CC0000
color2  #4E9A06
color3  #C4A000
color4  #3465A4
color5  #75507B
color6  #06989A
color7  #D3D7CF
color8  #555753
color9  #EF2929
color10 #8AE234
color11 #FCE94F
color12 #729FCF
color13 #AD7FA8
color14 #34E2E2
color15 #EEEEEC

# =====[ Window Behavior ]=====
confirm_os_window_close 0
enable_audio_bell no
bell_on_tab yes

# Allow some padding
window_padding_width 8
