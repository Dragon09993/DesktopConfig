# Modifiers and basic variables
set $mod Mod1
set $smod Shift

set $term kitty
set $browser chromium
set $launcher dmenu_run

# Font and visuals
font pango:FiraCode 10
set $gap 15
gaps inner $gap
gaps outer $gap

# Window border and layout
default_border pixel 2
default_floating_border pixel 2
smart_gaps on
smart_borders on

# FreeBSD red theme
set $active_bg   #CC0000
set $active_fg   #FCEFEF
set $inactive_bg #1A1A1A
set $inactive_fg #888888
set $background  #000000

client.focused          $active_bg $active_bg $active_fg $active_bg $active_fg
client.focused_inactive $inactive_bg $inactive_bg $inactive_fg $inactive_bg $inactive_fg
client.unfocused        $inactive_bg $inactive_bg $inactive_fg $inactive_bg $inactive_fg
client.urgent           $active_bg $active_bg $active_fg $active_bg $active_fg
client.placeholder      $inactive_bg $inactive_bg $inactive_fg $inactive_bg $inactive_fg
client.background       $background

# Launcher and core apps
bindsym $mod+Return exec $term
bindsym $mod+d exec $launcher
bindsym $mod+b exec $browser

# Power menu using dmenu
bindsym $mod+Shift+e exec --no-startup-id "echo -e 'shutdown\nreboot\nlogout' | dmenu -p 'Power:' | xargs -I CMD sh -c ' \
    [ CMD = logout ] && i3-msg exit || \
    [ CMD = reboot ] && sudo reboot || \
    [ CMD = shutdown ] && sudo shutdown -p now'"

# Browser menu
bindsym $mod+Shift+b exec --no-startup-id "echo -e 'firefox\nchromium\nqutebrowser' | dmenu -p 'Browser:' | xargs -r -I{} $SHELL -c '{} &'"

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Workspace bindings
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Move container to workspace
bindsym $mod+$smod+1 move container to workspace $ws1
bindsym $mod+$smod+2 move container to workspace $ws2
bindsym $mod+$smod+3 move container to workspace $ws3
bindsym $mod+$smod+4 move container to workspace $ws4
bindsym $mod+$smod+5 move container to workspace $ws5
bindsym $mod+$smod+6 move container to workspace $ws6
bindsym $mod+$smod+7 move container to workspace $ws7
bindsym $mod+$smod+8 move container to workspace $ws8
bindsym $mod+$smod+9 move container to workspace $ws9
bindsym $mod+$smod+0 move container to workspace $ws10

# Focus and movement
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+semicolon focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+semicolon move right

# Resize mode
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# Layout
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Misc
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+a focus parent

# Scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# Wallpaper
exec_always --no-startup-id feh --bg-fill /home/daniel/Downloads/bg.webp

# Bar settings
bar {
    position bottom
    font pango:FiraCode 10
    status_command i3status
    tray_output primary
    separator_symbol " - "
    colors {
        background $background
        statusline $active_fg
        separator $inactive_fg

        focused_workspace  $active_bg $active_bg $active_fg
        active_workspace   #A60000 #A60000 $active_fg
        inactive_workspace $inactive_bg $inactive_bg $inactive_fg
        urgent_workspace   $active_bg $active_bg $active_fg
    }
}

